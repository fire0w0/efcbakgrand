# Free-tier key from https://aistudio.google.com/apikey. Server-only; never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=4000
# Dev 3 supplies the real, published Google Form URL before 7:20 PM.
ORDER_FORM_URL=
